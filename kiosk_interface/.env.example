# Google Gemini API Keys from Google AI Studio (https://aistudio.google.com/app/apikey)
# Primary Gemini API Key
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Secondary & Tertiary Gemini API Keys for multi-key shuffling / failover pool
VITE_GEMINI_API_KEY1=your_second_gemini_api_key_here
VITE_GEMINI_API_KEY2=your_third_gemini_api_key_here

# Django Doctor Backend URL
VITE_BACKEND_URL=http://localhost:8000
